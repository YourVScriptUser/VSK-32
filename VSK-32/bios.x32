; VSK-32 Official Sysrom BIOS
; All Rights Reserved.

; Written in x32 Assembly for the x32 Assembler

; Hardware Ports:
;  KB_PORT                       ->     0x4B # The keyboard port, holds the key pressed
;  STORAGE_STATUS_NOTIFY_PORT    ->     0x00 # Tells the disk to do something 
;  STORAGE_SECTOR_PORT           ->     0xEA # Disk sector port
;  STORAGE_ADDRESS_PORT          ->     0xEB # Where the disk writes the sector to memory
;  STORAGE_STORAGE_MODE          ->     0xEC # Disk mode port 1 = read, 2 = write

; Hardware ISRs (IDs):
;  KB_ISR                        ->     0x01 # Keyboard interrupt routine (id - not address!)

; Exception ISRs (IDs) - Emulator Classes:
;  System.Exceptions.InvalidOpcodeError.UnknownOpcode: 63
;  System.Exceptions.InvalidOpcodeError.InvalidFlags:  62
;  System.Exceptions.InvalidRegister:                  61
;  System.Exceptions.InvalidMemoryWrite:               60
;  System.Exceptions.UnknownError:                     59
; (Pulled from emulator source code)

; *4 for real address

; Video Colors:
;  130: RED,
;  131: GREEN,
;  132: BLUE,
;  133: BRIGHT_BLACK,
;  134: CYAN,
;  135: BG_RED,
;  136: RESET

; BIOS Uses r20 as a text cursor
; Do not clobber r20

; BIOS Region:
;  Total        : 00000000 - 00005400  
;  Code         : 0000100A - 00005400  ( Including interrupt code )
;  Stack        : 00005400 - 00005BAA  (       Not Enforced       )
;  Boot Sector  : 00005C00 - 00006000  (  Boot Sector loaded here )

; BIOS file is 21KiB

; Keyboard buffer at:
;  00000F00 - 00000FFF
; Keyboard buffer cursor at:
;  00000EFF

; Emulator video memory at:
;  0B800000 - 0B800FFF

; BIOS Interrupts:
;  BIOS Interrupt IVT ID reserved: 5-20
;  ID * 4 = dword address of vector
; ABI:
;  ( ID: Explanation )

;  14: Teletype               (0x0E)
;      r0: ASCII Letter to print

;   5: Disk read              (0x05)
;      r0: Sector
;      r1: Address

;   6: Disk write             (0x06)

;  10: Clear Keyboard Buffer  (0x0A)


; Keyboard buffer cursor is relative to the base address
; This is so the cursor can stay as a singular byte (This is why the size of the keyboard buffer is 256B)
; To calculate the real address of the key pressed byte: Address = Cursor + Keyboard Base Address
; BIOS Stores its video cursor at print.teletype_cursor - A single byte stored inside the BIOS code.

; BSH (Boot Sector Header) Layout:
;  55 AA Expected to be exactly at:                     5C00-5C01
;  Null-terminated OS string expected to be exactly at: 5C02-5C35
;  Boot Code to start and end at exactly:               5C40-6000
; BIOS Loads the kernelspace stack to 000F0000

region 0x00000000
jmp 0x0000100A

region 0x0000100A
cli                    ; Interrupts wont work this early
clf                    ; Clear flags
ssp BIOS_STACK_BASE    ; Setup early BIOS stack
jmp bios_entp

; BIOS INTERRUPTS 

; Keyboard HWI Code
; Runs when a key is pressed and HWIs are enabled
;
; Interrupt ID 1 (ISR 0x4)
interrupts.keyboard:
  cli               ; Disable interrupts, interrupts occouring during handling of a interrupt will corrupt state.

  in r3, 0x4B       ; Read the key pressed from the keybord port
  ; Key pressed now in r3
  
  ; Check bounds of the keyboard buffer
  ; Clear keyboard buffer if it is too big (at 256) - Cursor cannot physically go beyond 256 since it is a byte.
  call keyboard.read_cursor

  ; End Address = Base address + (Size - 1)
  ldi r0, KEYBOARD_BUFFER_BASE
  ldi r1, KEYBOARD_BUFFER_SIZE
  sub r1, 1
  add r0, r1
  
  push r3
  cmp r0, r10
  je keyboard.clear_internal
  keyboard_clear_return:
  call keyboard.read_cursor ; refresh this incase a clear happened
  pop r3
  ; then write the key
  wb [r10], r3
 
  ; Increment the buffer cursor
  add r10, 1
 
  ; Write back the incremented cursor
  ldi r9,  KEYBOARD_BUFFER_CURSOR_ADDRESS
  wb [r9], r10
  
  clf   ; Clear comparison flags
  ; FIX:
  ;  For programs that wait for input using a sti;hlt loop, this would break randomley and cause a halted CPU because:
  ; sti
  ; emulator checks for interrupts
  ; interrupt happens
  ; to handler
  ; interrupts get disabled
  ; hlt
  ;  FIX: Since this code can only be entered if interrupts are on anyway, make this code re-enable interrupts.
  
  sti   ; Fix applied.
  iret  ; Return from interrupt

  ; Returns the cursor in r10
  ; Not the raw cursor - returns it relative to the base address of the keyboard buffer
  keyboard.read_cursor:  
    ldi r9, KEYBOARD_BUFFER_CURSOR_ADDRESS
    rb r10, [r9]

    ldi r9, KEYBOARD_BUFFER_BASE
    add r10, r9
  
    ret
  
  ; DO NOT USE Outside of interrupt code
  ; Uses **iret**  
  ; Will corrupt every single register upon running outside a interrupt context
  keyboard.clear_internal:
    xor r0, r0
    xor r1, r1
  
    ldi r0, KEYBOARD_BUFFER_BASE
    ldi r1, KEYBOARD_BUFFER_SIZE
  
    ; End Address = Base address + (Size - 1)
    sub r1, 1
    add r0, r1
    ; r0 = End Address
  
    ldi r1, KEYBOARD_BUFFER_BASE ;  Var Current Ptr
    jmp keyboard.clear_loop_internal
  
  keyboard.clear_loop_internal:
    ldi r2, 0
    wb [r1], r2
  
    add r1, 1
  
    cmp r1, r0
    je keyboard.clear_end_internal
  
    jmp keyboard.clear_loop_internal
    
  
  keyboard.clear_end_internal:
    ; Reset keyboard cursor
    ; Since the cursor is relative to base address, 0 it.
    ; For more documentation about this behaviour, see keyboard.init  

    ldi r0, 0
    ldi r1, KEYBOARD_BUFFER_CURSOR_ADDRESS
    wb [r1], r0

    clf
    ; FIX: Early termination when the buffer was cleared was causing missed keys
    jmp keyboard_clear_return

  ; Clears the keyboard buffer
  ; Overwrites it with 0s
  keyboard.clear:
    xor r0, r0
    xor r1, r1
  
    ldi r0, KEYBOARD_BUFFER_BASE
    ldi r1, KEYBOARD_BUFFER_SIZE
  
    ; End Address = Base address + (Size - 1)
    sub r1, 1
    add r0, r1
    ; r0 = End Address
  
    ldi r1, KEYBOARD_BUFFER_BASE ;  Var Current Ptr
    jmp keyboard.clear_loop
  
  keyboard.clear_loop:
    ldi r2, 0
    wb [r1], r2
  
    add r1, 1
  
    cmp r1, r0
    je keyboard.clear_end
  
    jmp keyboard.clear_loop
    
  
  keyboard.clear_end:
    ; Reset keyboard cursor
    ; Since the cursor is relative to base address, 0 it.
    ; For more documentation about this behaviour, see keyboard.init  

    ldi r0, 0
    ldi r1, KEYBOARD_BUFFER_CURSOR_ADDRESS
    wb [r1], r0

    clf
    ret  ; Not for use inside interrupt

  ; Initializes the keyboard device
  keyboard.init:
    ; Write the base address to the cursor
    ; The cursor is relative to the base
    ; Which means it points to 0 when empty
    ; Cursor = 0 + Base Address

    ldi r0, 0
    ldi r1, KEYBOARD_BUFFER_CURSOR_ADDRESS
    wb [r1], r0

    ; Wipe the buffer
    call keyboard.clear

    ; Done, clear flags and return.
    clf 
    ret

; Teletype SWI
; r0: ASCII Letter
; Can only print 256 chars at a time before it overflows
; ID 14
interrupts.teletype:
  ; Read current cursor
  ldi r1, print.teletype_cursor
  rb  r2, [r1]

  ; Get cursor relative to video memory
  ldi r1, VIDEO_MEM_BASE
  add r2, r1

  ; Write the char there
  wb  [r2], r0
  
  ; Add 1 to the cursor and save it back
  ldi r1, print.teletype_cursor
  rb  r2, [r1]
  add r2, 1
  wb  [r1], r2

  ; Done, return.
  iret

; Disk Ports:
;  STORAGE_STATUS_NOTIFY_PORT    ->     0x00 # Tells the disk to do something 
;  STORAGE_SECTOR_PORT           ->     0xEA # Disk sector port
;  STORAGE_ADDRESS_PORT          ->     0xEB # Where the disk writes/copies the sector to memory
;  STORAGE_STORAGE_MODE          ->     0xEC # Disk mode port 1 = read, 2 = write

; Disk Read SWI
; r0: Sector to read
; r1: Memory Address to write
; ID 5
interrupts.disk_read:
  ldi r2, 0
  out r2, 0x00

  ldi r2, 1
  out r2, 0xEC

  out r0, 0xEA
  
  out r1, 0xEB

  ldi r2, 1
  out r2, 0x00

  ldi r2, 0
  out r2, 0x00

  iret
  
; Disk Write SWI
; r0: Sector to write
; r1: Memory Address to copy over
; ID 6
interrupts.disk_write:
  ldi r2, 0
  out r2, 0x00

  ldi r2, 2
  out r2, 0xEC

  out r0, 0xEA
  
  out r1, 0xEB

  ldi r2, 1
  out r2, 0x00

  ldi r2, 0
  out r2, 0x00

  iret  

; Clear Keyboard Buffer SWI
; ID 10
interrupts.clear_kbuf:
  call keyboard.clear
  iret

; =======================================================================================

; BIOS MAIN

; Installs every interrupt ISR
setup_interrupts:
  ldi r10, STRING_INTERRUPT_INIT
  call print


  ; Start

  ; Keyboard
  ldi r0, 1 ; Id
  ; IVT Entries are dwords, so:
  ;  ISR Address = Id * 4

  mul r0, 4
  ; r0 = Address (ISR Address = Id * 4)
  ; Write that to the resolved ISR Address
  ldi r3, interrupts.keyboard
  mov [r0], r3


  

  ; Teletype
  ldi r0, 14
  mul r0, 4
  
  ldi r3, interrupts.teletype
  mov [r0], r3

  ; Disk read
  ldi r0, 5
  mul r0, 4

  ldi r3, interrupts.disk_read
  mov [r0], r3

  ; Disk write
  ldi r0, 6
  mul r0, 4

  ldi r3, interrupts.disk_write
  mov [r0], r3

  ; Clear keyboard buffer
  ldi r0, 10
  mul r0, 4

  ldi r3, interrupts.clear_kbuf
  mov [r0], r3

  ; Finish
  call pause
  ldi r10, STRING_DONE
  call print
  ret ; return
  
; Initializes hardware devices
setup_devices:
  ; Current devices list (at time of this source write):
  ;  Keyboard

  ldi r10, STRING_HARDWARE_INIT
  call print 

  ; Call the initialization routines
  call keyboard.init
  call pause
  
  ldi r10, STRING_DONE
  call print

  ret
  

; Main BIOS Entrypoint
bios_entp:
  ; Initialize the video MMIO region
  ; Video ports are 0xDC for start address and 0xDD for end address
  ; Initialize it to the default 0x0B800000:0x0B800FFF
  ldi r0, VIDEO_MEM_BASE
  copy r1, r0
  add r1, 0xFFF
  out r0, 0xDC
  out r1, 0xDD

  call print.init 

  ldi r10, STRING_BIOS_BANNER
  call print

  call print.newline

  call setup_devices
  call setup_interrupts

  call pause.long

  call do_boot

  ; Upon do_boot returning, that means no OS was found.
  ; Halt.
  die:
    cli
    hlt
    jmp die
  

  
; Reads the boot sector and reads the boot signature
;  **Upon** Successful boot:
;   Does not return
;   Moves stack to kernelspace stack region
;   Jumps to boot sector code address at 0x5C00
; **Upon** Unsuccessful boot:
;   Prints error
;   Returns to bios_entp 
do_boot:
  ldi r10, STRING_BOOT
  call print

  ; Step 1: Read boot sector, load it at 0x5C00
  ldi r0, 0  ; Boot sector is sector 0
  ldi r1, BOOT_SECTOR_LOAD_ADDRESS ; 00005C00

  int 0x05  ; Read and place at BOOT_SECTOR_LOAD_ADDRESS

  ; Read the signature (55 AA)
  ldi r0, BOOT_SECTOR_LOAD_ADDRESS
  rb  r1, [r0]
  cmp r1, 0x55
  jne do_boot.bad_sig

  add r0, 1 ; Now points to 00005C01
  rb  r1, [r0]
  cmp r1, 0xAA
  jne do_boot.bad_sig
 
  ; If we get here, that means both signatures were correct. 
  ldi r10, STRING_DONE
  call print

  ; Now print the OS string, move SP to the kernelspace stack, 0 all registers and jump to entrypoint
  call print.newline
  ldi r10, STRING_OS_FOUND
  call print
  ldi r10, STRING_QUOTE
  call print

  ldi r10, 0x00005C02 ; String name address after the signature
  call print

  ldi r10, STRING_QUOTE
  call print

  call print.newline
  call pause.long  
  call pause.long

  ; Clear the screen
  call clear_video

  ; Clear registers
  xor r0, r0
  xor r1, r1
  xor r2, r2
  xor r3, r3
  xor r4, r4
  xor r5, r5
  xor r6, r6
  xor r7, r7
  xor r8, r8
  xor r9, r9
  xor r10, r10
  xor r11, r11
  xor r12, r12
  xor r13, r13
  xor r14, r14
  xor r15, r15
  xor r16, r16
  xor r17, r17
  xor r18, r18
  xor r19, r19
  xor r20, r20
  xor r21, r21
  xor r22, r22
  xor r23, r23

  ; Setup stack
  ssp KERNEL_SPACE_STACK

  ; Jump to entrypoint
  jmp 0x00005C40


  
clear_video:
  ldi r0, VIDEO_MEM_BASE
  sub r0, 1
  jmp CLEAR.loop

CLEAR.loop:
  ldi r1, 0
  wb [r0], r1

  cmp r0, 0x0B800FFF
  je CLEAR.end
  add r0, 1
  
  jmp CLEAR.loop

  

CLEAR.end:
  clf 
  ret  

; Jump here when the boot signature is invalid
do_boot.bad_sig:
  ldi r10, STRING_FAIL
  call print
  call print.newline

  ldi r10, STRING_OS_NOT_FOUND
  call print
 
  ret  ; return to bios_entp



; Main BIOS print routine
; Register Args:
; **r10**: String address
print:
  jmp print.loop
  
; Teletype cursor, seperate from r20.
print.teletype_cursor:
  db 0

print.init:
  ldi r20, VIDEO_MEM_BASE
  ret

print.newline:
  ldi r0, 10
  wb [r20], r0

  add r20, 1
  ret

print.loop:
  rb r11, [r10]

  cmp r11, 0
  je print.end

  wb [r20], r11

  add r10, 1
  add r20, 1
 
  jmp print.loop

  

print.end:
  clf
  ret

; Spins for a while to make a delay
pause:
  ldi r0, 0x00000F00
  ldi r1, 0
  jmp pause.loop

; Pause *2
pause.long:
  call pause
  call pause
  ret

pause.loop: 
  add r1, 1
  cmp r0, r1
  je pause.end
  jmp pause.loop  

pause.end:
  clf
  xor r0, r0
  xor r1, r1
  ret


; STRING POOL
STRING_BIOS_BANNER: 
  db 132, "VSK Software sysROM BIOS v2.1.0", 10
  db      "VSK-32 Proprietary ROM BIOS", 10

  db 0

STRING_HARDWARE_INIT:
  db 133, "Initializing hardware..."

  db 0

STRING_BOOT:
  db 133, "Reading boot sector..."

  db 0

STRING_INTERRUPT_INIT:
  db 133, "Initializing interrupts..."
 
  db 0

STRING_DONE:
  db 133, " done", 10
  
  db 0

STRING_OS_FOUND:
  db 133, "OS Found: "

  db 0

STRING_QUOTE:
  db 133, "'"

  db 0

STRING_OS_NOT_FOUND:
  db 133, "Boot Failed: Not a bootable disk."

  db 0

STRING_FAIL:
  db 133, " fail", 10

  db 0

region 0x00005BAA
; Base address of the BIOS stack
BIOS_STACK_BASE:

region 0x0B800000
; Base address of video memory
VIDEO_MEM_BASE:

region 0x00000F00
; Base address of the keyboard buffer
KEYBOARD_BUFFER_BASE:

region 256
; Keyboard buffer size
KEYBOARD_BUFFER_SIZE:

region 0x00000EFF
; Keyboard buffer cursor address
KEYBOARD_BUFFER_CURSOR_ADDRESS:

region 0x00005C00
; Where the boot sector is loaded into memory
BOOT_SECTOR_LOAD_ADDRESS:

region 0x0F000000
; Points to the base address of the OS stack
KERNEL_SPACE_STACK:




